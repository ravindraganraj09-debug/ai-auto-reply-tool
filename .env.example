# --- Razorpay (LIVE production keys) ---
# Backend-only secrets. NEVER expose RAZORPAY_KEY_SECRET to the browser.
# Use rzp_live_* keys in production. Test mode uses rzp_test_*.
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

# Frontend exposes ONLY the publishable key id. In a Next.js build this is read
# from NEXT_PUBLIC_RAZORPAY_KEY_ID at build time. In this vanilla frontend it
# is fetched at runtime from GET /api/payments/config (no secret is sent).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID

# --- Razorpay Subscriptions (auto-debit recurring billing) ---
# Create a Plan in Razorpay dashboard for each tier (monthly billing cycle,
# price in paise) and paste the resulting plan_xxx ids here. If left blank, the
# corresponding tier falls back to one-time monthly orders automatically.
RAZORPAY_PLAN_ID_STARTER=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_BUSINESS=plan_xxxxxxxxxxxxxx

# How many billing cycles a subscription should run before Razorpay stops
# attempting auto-debit. Default 12 (~1 year). Customer can re-subscribe after.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=12

# Webhook signing secret. In Razorpay dashboard go to:
#   Settings -> Webhooks -> Create webhook
#   URL: https://<your-backend>/webhooks/razorpay
#   Events: subscription.activated, subscription.charged, subscription.cancelled,
#           subscription.completed, subscription.halted, subscription.paused,
#           subscription.resumed, subscription.pending, payment.failed
# Then copy the secret it generates here.
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
JWT_SECRET=replace_with_secure_jwt_secret
MONGO_URI=your_mongodb_connection_string
MONGO_DB_NAME=ai_auto_reply
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest
GEMINI_API_AUTH_MODE=header
GEMINI_REQUEST_TIMEOUT_MS=4000
APP_WORKSPACE_ID=replypilot-main
CHATBOT_TITLE=ReplyPilot Assistant
CHATBOT_BUSINESS_CONTEXT=Describe your business, services, location, and support style for the website chatbot
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_any_secret_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_AUTO_REPLY_ENABLED=false
WHATSAPP_BUSINESS_CONTEXT=Describe your WhatsApp business context for auto replies
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=choose_any_instagram_verify_token
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_AUTO_REPLY_ENABLED=false
